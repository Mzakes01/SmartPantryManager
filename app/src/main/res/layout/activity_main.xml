<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F8F3">
    android:id="@+id/btnSettings"

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#276749"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage your available ingredients"
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="20dp"/>

    <ListView
        android:id="@+id/pantryListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:backgroundTint="#276749"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnRecipeSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Recipes"
        android:layout_marginTop="8dp" />


    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings &amp; Profile"
        android:layout_marginTop="8dp" />

</LinearLayout>